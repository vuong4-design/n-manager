{
  "manifest_version": 3,
  "name": "Notion AI Config Extractor",
  "version": "1.5",
  "description": "Extract Notion AI account config (token_v2, userId, spaceId) / 一键提取 Notion AI 账号配置",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://notion.so/*",
    "https://www.notion.so/*",
    "https://*.notion.so/*",
    "https://notion.com/*",
    "https://www.notion.com/*",
    "https://*.notion.com/*",
    "https://app.notion.com/*",
    "https://mail.notion.com/*",
    "http://localhost:8081/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
